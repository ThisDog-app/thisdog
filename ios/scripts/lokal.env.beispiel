# Lokale Werte für ipad-bauen.sh und ipad-link.sh.
# Kopieren nach scripts/lokal.env und ausfüllen. lokal.env steht in .gitignore und gehört nie ins Repository.

# --- ipad-bauen.sh -----------------------------------------------------------------------------------
# UDID des iPads (Finder oder: xcrun devicectl list devices). Das Team-Profil muss das Gerät enthalten.
IPAD_UDID=""
# Signaturidentität, wie sie `security find-identity -v -p codesigning` anzeigt.
SIGN_IDENTITY="Apple Development: name@example.org (XXXXXXXXXX)"

# --- beide, optional ---------------------------------------------------------------------------------
# Eigener Schlüsselbund mit dem Zertifikat. Leer lassen: der Standard-Schlüsselbund.
SIGN_KEYCHAIN=""                    # z. B. "$HOME/Library/Keychains/signieren.keychain-db"
# Datei, die nur das Passwort dieses Schlüsselbunds enthält (Pflicht, wenn SIGN_KEYCHAIN gesetzt ist).
SIGN_KEYCHAIN_PASSWORD_FILE=""      # z. B. "$HOME/.signieren"

# --- ipad-link.sh ------------------------------------------------------------------------------------
# ssh-Name des Webservers (Eintrag in ~/.ssh/config).
LADEN_SSH=""
# Ordner auf dem Server, relativ zum Heimatverzeichnis; muss unter LADEN_URL erreichbar sein.
LADEN_ZIEL="public_html/laden"
# Öffentliche Adresse dieses Ordners, mit https (itms-services verlangt es).
LADEN_URL="https://example.org/laden"
